# Used by docker-compose.yml
FRONTEND_PORT=8081
BACKEND_PORT=8080
VITE_API_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8081
# Required for the backend: signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=
# Optional: Finnhub API key for real quotes (leave empty to use the built-in simulator)
MARKET_API_KEY=
