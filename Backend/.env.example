PORT=8080
MONGODB_URL=mongodb://127.0.0.1:27017/stocks

# Comma-separated browser origins allowed by CORS (unset = any origin). Add your LAN origin, e.g. http://192.168.1.79:5173
CORS_ORIGIN=
# Bind address (default 0.0.0.0, reachable from the LAN)
HOST=0.0.0.0

# Required in production: long random string that signs JWT login tokens (openssl rand -hex 32).
# In development an unset value uses a temporary random secret and sessions end when the server restarts.
JWT_SECRET=
# Optional: Finnhub API key (read only from the environment, never sent to the browser). Empty = simulated prices.
MARKET_API_KEY=
